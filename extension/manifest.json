{
  "manifest_version": 3,
  "name": "OpenYouTubeClaw",
  "version": "0.3.36",
  "description": "YouTube-only local AI recommendation agent.",
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "dist/content/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
